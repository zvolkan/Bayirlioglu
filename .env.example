# ─────────────────────────────────────────────────────
# MARKA SEÇİMİ
# Hangi markanın aktif olacağını belirler.
# Değerler: 'alb-tarim' | 'alb-su-aritma'
# ─────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND=alb-tarim
NEXT_PUBLIC_SITE_NAME="ALB Tarım"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────
# VERİTABANI (PostgreSQL)
# ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/bayirlioglu_db

# ─────────────────────────────────────────────────────
# WHATSAPP
# ─────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_ALB_TARIM=905071781633
NEXT_PUBLIC_WHATSAPP_ALBSU=905444142254

# ─────────────────────────────────────────────────────
# E-POSTA (SMTP)
# ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@example.com
SMTP_PASS=your_password

# ─────────────────────────────────────────────────────
# ÖDEME (İyzico / Stripe)
# ─────────────────────────────────────────────────────
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ─────────────────────────────────────────────────────
# KARGO (Mng / Yurtiçi API)
# ─────────────────────────────────────────────────────
CARGO_API_KEY=your_cargo_api_key
