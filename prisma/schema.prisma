// Bayirlioglu E-Ticaret — Prisma Schema
// Veritabanı: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── MARKALAR ────────────────────────────────────────────────────────────────

model Brand {
  id          Int        @id @default(autoincrement())
  key         String     @unique @db.VarChar(30)
  name        String     @db.VarChar(100)
  description String?
  logoUrl     String?    @map("logo_url") @db.VarChar(500)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")

  categories  Category[]
  products    Product[]
  orders      Order[]

  @@map("brands")
}

// ─── KATEGORİLER ─────────────────────────────────────────────────────────────

model Category {
  id          Int        @id @default(autoincrement())
  brandId     Int        @map("brand_id")
  parentId    Int?       @map("parent_id")
  name        String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(100)
  description String?
  imageUrl    String?    @map("image_url") @db.VarChar(500)
  icon        String?    @db.VarChar(100)
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")

  brand       Brand      @relation(fields: [brandId], references: [id])
  parent      Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryParent")
  products    Product[]

  @@map("categories")
}

// ─── ÜRÜNLER ─────────────────────────────────────────────────────────────────

model Product {
  id               String   @id @default(cuid())
  categoryId       Int      @map("category_id")
  brandId          Int      @map("brand_id")
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  description      String?  @db.Text
  shortDescription String?  @map("short_description") @db.VarChar(1000)
  sku              String?  @unique @db.VarChar(100)
  barcode          String?  @db.VarChar(100)

  // Fiyat
  price            Decimal  @db.Decimal(10, 2)
  salePrice        Decimal? @map("sale_price") @db.Decimal(10, 2)

  // Stok
  stockQuantity    Int      @default(0) @map("stock_quantity")
  minStockLevel    Int      @default(5) @map("min_stock_level")
  unit             String   @default("adet") @db.VarChar(50)
  weight           Decimal? @db.Decimal(8, 3)

  // Durum
  isActive         Boolean  @default(true) @map("is_active")
  isFeatured       Boolean  @default(false) @map("is_featured")

  // SEO
  metaTitle        String?  @map("meta_title") @db.VarChar(255)
  metaDescription  String?  @map("meta_description") @db.Text

  // Değerlendirme (ortalama — review tablosu hazır değil iken burada tutuyoruz)
  rating           Decimal  @default(0) @map("rating") @db.Decimal(3, 1)
  reviewCount      Int      @default(0) @map("review_count")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // İlişkiler
  category    Category       @relation(fields: [categoryId], references: [id])
  brand       Brand          @relation(fields: [brandId], references: [id])
  images      ProductImage[]
  specs       ProductSpec[]
  tags        ProductTag[]
  orderItems  OrderItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

// ─── ÜRÜN GÖRSELLERİ ─────────────────────────────────────────────────────────

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId String  @map("product_id")
  url       String  @db.VarChar(500)
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─── TEKNİK ÖZELLİKLER ───────────────────────────────────────────────────────

model ProductSpec {
  id         Int     @id @default(autoincrement())
  productId  String  @map("product_id")
  specName   String  @map("spec_name") @db.VarChar(100)
  specValue  String  @map("spec_value") @db.VarChar(255)
  specUnit   String? @map("spec_unit") @db.VarChar(50)
  sortOrder  Int     @default(0) @map("sort_order")

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

// ─── ETİKETLER ───────────────────────────────────────────────────────────────

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique @db.VarChar(100)
  slug     String       @unique @db.VarChar(100)
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String  @map("product_id")
  tagId     Int     @map("tag_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// ─── KULLANICILAR ─────────────────────────────────────────────────────────────
// id: Supabase auth.users UUID ile eşleşir

model User {
  id        String    @id @db.Uuid
  email     String    @unique @db.VarChar(255)
  name      String?   @db.VarChar(150)
  phone     String?   @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  addresses Address[]
  orders    Order[]

  @@map("users")
}

// ─── ADRESLER ─────────────────────────────────────────────────────────────────

model Address {
  id         String  @id @default(cuid())
  userId     String  @map("user_id") @db.Uuid
  label      String  @db.VarChar(50)   // "Ev", "Çiftlik", vb.
  fullName   String  @map("full_name") @db.VarChar(150)
  phone      String  @db.VarChar(20)
  line1      String  @db.VarChar(255)
  line2      String? @db.VarChar(255)
  district   String  @db.VarChar(100)
  city       String  @db.VarChar(100)
  postalCode String? @map("postal_code") @db.VarChar(10)
  isDefault  Boolean @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([userId])
  @@map("addresses")
}

// ─── SİPARİŞLER ───────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id            String      @id @default(cuid())
  userId        String      @map("user_id") @db.Uuid
  addressId     String?     @map("address_id")
  brandId       Int         @map("brand_id")
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(12, 2)
  notes         String?     @db.Text
  paymentMethod String?     @map("payment_method") @db.VarChar(50)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user    User       @relation(fields: [userId], references: [id])
  address Address?   @relation(fields: [addressId], references: [id])
  brand   Brand      @relation(fields: [brandId], references: [id])
  items   OrderItem[]

  @@index([userId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String  @map("order_id")
  productId  String  @map("product_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}
